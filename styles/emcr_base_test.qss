/* ========================================================================= */
/* EMCR BASE TEMPLATE STYLESHEET                                             */
/* ========================================================================= */

QWidget {
    color: @TEXT_MAIN;
    font-family: "Inter", sans-serif;
    font-weight: regular;
    font-size: 10px; 
    outline: none;
}

QMainWindow,
QDockWidget, 
QDialog {
    background: @BG_APP; 
}

QLabel#dlgExitMsg{
    color: @TEXT_MAIN;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
}

QPushButton#dlgDisconnectBtn{
    background-color: @ACCENT_RED;
    color: @TEXT_SECONDARY;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton#dlgDisconnectBtn:hover { 
    background-color: @ACCENT_LRED;
    border-color: @ACCENT_RED;
    color: @TEXT_MAIN;
}

QPushButton#dlgCancelBtn{
    color: @TEXT_MAIN;
    border: 1px solid @BORDER_INPUT;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 12px;
}

QPushButton#dlgCancelBtn:hover { background-color: @BG_BTN_HOVER; }

/* --- TEXT DENSITY & FONTS --- */

QLabel {
    color: @TEXT_MAIN;
    font-weight: regular;
    font-size: 10px; 
}

QLabel:disabled {
    color: @TEXT_MUTED;
}


/* Valori Numerici e Dati */
QWidget[technical="true"] {
    font-family: "Inria Sans";
    font-size: 13px;
    color: @ACCENT_ORANGE; 
}

/* --- CONTAINERS --- */

QGroupBox {
    border: 1px solid @BORDER_STD;
    border-radius: 4px;
    margin-top: 18px;
    font-size: 10px;
    text-transform: uppercase;
    color: @TEXT_SECONDARY;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 3px;
}


/* --- INPUTS & WIDGETS --- */

QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 10px;
    min-height: 20px;
    min-width: 65px;
    max-width: 110px;
    border: 1px solid @BORDER_INPUT;
    border-radius: 4px;
    color: @ACCENT_ORANGE;
    background-color: @BG_INPUT;
}


QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: @BORDER_FOCUS;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    height: 16px;
    border: none;
    background: transparent;
}

QDoubleSpinBox::up-button, QSpinBox::up-button { subcontrol-position: right; right: 18px; }
QDoubleSpinBox::down-button, QSpinBox::down-button { subcontrol-position: right; right: 4px; }

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(@ICON_PREFIX/arrow_up.svg); width: 10px; height: 10px; padding-top: 1px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(@ICON_PREFIX/arrow_down.svg); width: 10px; height: 10px; padding-bottom: 1px; }

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: @BG_BTN_HOVER;
    border-radius: 2px;
}

QListView::item {
    padding: 3px 8px;
    color: @TEXT_MAIN;
    border: 1px solid transparent;
    border-radius: 2px;
}

QListView::item:disabled {
    color: @TEXT_MUTED;
}

QListView::item:alternate {
    background-color: @BG_APP; 
}

QListView::item:hover {
    background-color: @BG_BTN_HOVER;
    color: @TEXT_MAIN;
}

QListView::item:selected:active {
    background-color: @SELECTION_BLUE;
    color: @TEXT_LIGHT;
    border: 1px solid @ACCENT_BLUE;
}

QListView::item:selected:!active {
    background-color: @BG_BTN_HOVER; 
    color: @TEXT_MAIN;
    border: 1px solid @BORDER_PANEL;
}

/* --- BUTTONS --- */
QPushButton {
    background-color: @BG_BTN;
    border: 1px solid @BORDER_INPUT;
    border-radius: 3px;
    padding: 4px 12px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: @BG_BTN_HOVER;
    border-color: @BORDER_FOCUS;
}

QPushButton:pressed {
    background-color: @BG_BTN_PRESS;
    border-color: @ACCENT_ORANGE;
}

QPushButton:checked {
    background-color: @SELECTION_BLUE;
    border-color: @BORDER_FOCUS;
}

QPushButton:disabled {
    background-color: @BG_APP;
    color: @TEXT_MUTED;
    border-color: @BORDER_STD;
}

QTabBar::base {
    background-color: @BG_APP;
    border: none;
}

/* --- MENUS & TOOLTIPS --- */
QToolTip {
    background-color: @BG_HEADER;
    color: @TEXT_LIGHT;
    border: 1px solid @BORDER_PANEL;
    border-radius: 4px;
    padding: 4px;
}

QStatusBar QLabel {
    padding: 4px 8px;
    color: @TEXT_LIGHT;
}

QMenuBar {
    background-color: @BG_PANEL;
    color: @TEXT_MAIN;
    padding: 5px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 10px;
    margin-left: 4px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: @ITEM_SELECTED;
}

QMenuBar::item:pressed {
    background-color: @ITEM_PRESS;
    color: @TEXT_SECONDARY;
}

QMenu {
    background-color: @BG_PANEL;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 1px;
    border: 1px solid @BORDER_LIGHT;
    border-radius: 4px;
}

QMenu::indicator,
QMenu::icon {
    left: 4px; 
}

QMenu::separator {
    height: 1px;
    color: @BORDER_PANEL
}

QMenu::item {
    background-color: transparent;
    padding: 5px 15px;
    border-radius: 5px;
    min-width: 60px;
    margin-top: 3px;
    margin-bottom: 3px;
}

QMenu::item:selected {
    background-color: @ITEM_SELECTED;
}

QMenu::item:pressed {
    background-color: @ITEM_PRESS;
}

QMenu::right-arrow {
    image: url(@ICON_PREFIX/arrow_right.svg);
    width: 10px;
    height: 10px;
}

QMenuBar:disabled {
    color: @TEXT_MUTED;
}

QMenu::item:disabled {
    color: @TEXT_MUTED;
    background-color: transparent;
}

/* --- CHECKBOX & RADIO --- */
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @BORDER_INPUT;
    border-radius: 2px;
    background-color: @BG_INPUT;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: @BORDER_FOCUS;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: @ACCENT_BLUE;
    border-color: @ACCENT_LBLUE;
    image: url(@ICON_PREFIX/check-solid.svg);
}

/* --- SLIDERS --- */
QSlider::groove:horizontal {
    height: 4px;
    background: @BORDER_STD;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: @ACCENT_ORANGE;
    width: 12px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 6px;
}


/* --- SCROLLBAR --- */

/* QScrollBar {
  border-radius: 0;
  font-size: 13pt;
}

QScrollBar:vertical {
  border-left: 1px solid #1c1c1c;
  width: 10px;
}

QScrollBar:horizontal {
  border-top: 1px solid #1c1c1c;
  height: 10px;
}

