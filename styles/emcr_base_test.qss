/* ========================================================================= */
/* EMCR BASE TEMPLATE STYLESHEET                                             */
/* ========================================================================= */

QWidget {
    color: @TEXT_MAIN;
    font-family: "Inter", sans-serif;
    font-size: 10px; 
    outline: none;
}

QMainWindow, QDialog {
    background-color: @BG_APP; 
}

/* --- TEXT DENSITY & FONTS --- */
QLabel:disabled {
    color: @TEXT_MUTED;
}

/* Valori Numerici e Dati */
QWidget[technical="true"] {
    font-family: "Inria Sans";
    font-size: 13px;
    color: @ACCENT_ORANGE; 
}

/* --- CONTAINERS --- */
QGroupBox {
    border: 1px solid @BORDER_STD;
    border-radius: 4px;
    margin-top: 18px;
    font-size: 10px;
    text-transform: uppercase;
    color: @TEXT_SECONDARY;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 3px;
}

/* --- INPUTS & WIDGETS --- */
QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox {
    background-color: @BG_INPUT;
    border: 1px solid @BORDER_INPUT;
    border-radius: 2px;
    padding: 3px 5px;
    color: @ACCENT_ORANGE;
    selection-background-color: @ACCENT_ORANGE;
    selection-color: @BG_APP;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: @BORDER_FOCUS;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    height: 16px;
    border: none;
    background: transparent;
}

QDoubleSpinBox::up-button, QSpinBox::up-button { subcontrol-position: right; right: 16px; }
QDoubleSpinBox::down-button, QSpinBox::down-button { subcontrol-position: right; right: 0px; }

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(@ICON_PREFIX/arrow_up.svg); width: 16px; height: 16px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(@ICON_PREFIX/arrow_down.svg); width: 16px; height: 16px; }

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: @BG_BTN_HOVER;
}

/* --- BUTTONS --- */
QPushButton {
    background-color: @BG_BTN;
    border: 1px solid @BORDER_INPUT;
    border-radius: 3px;
    padding: 4px 12px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: @BG_BTN_HOVER;
    border-color: @BORDER_FOCUS;
}

QPushButton:pressed {
    background-color: @BG_BTN_PRESS;
    border-color: @ACCENT_ORANGE;
}

QPushButton:checked {
    background-color: @SELECTION_BLUE;
    border-color: @BORDER_FOCUS;
}

QPushButton:disabled {
    background-color: @BG_APP;
    color: @TEXT_MUTED;
    border-color: @BORDER_STD;
}

/* --- MENUS & TOOLTIPS --- */
QToolTip {
    background-color: @BG_HEADER;
    color: @TEXT_LIGHT;
    border: 1px solid @BORDER_PANEL;
    border-radius: 4px;
    padding: 4px;
}

QStatusBar QLabel {
    padding: 4px 8px;
    color: @TEXT_LIGHT;
}

QMenuBar {
    background-color: @BG_PANEL;
    color: @TEXT_LIGHT;
    padding: 5px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 10px;
    margin-left: 4px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: @ITEM_SELECTED;
}

QMenuBar::item:pressed {
    background-color: @ITEM_PRESS;
    color: @TEXT_SECONDARY;
}

QMenu {
    background-color: @BG_HEADER;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 1px;
    border: 1px solid @BORDER_LIGHT;
    border-radius: 4px;
}

QMenu::indicator,
QMenu::icon {
    left: 4px; 
}

QMenu::separator {
    height: 1px;
    color: @BORDER_PANEL
}

QMenu::item {
    background-color: transparent;
    padding: 5px 15px;
    border-radius: 5px;
    min-width: 60px;
    margin-top: 3px;
    margin-bottom: 3px;
}

QMenu::item:selected {
    background-color: @ITEM_SELECTED;
}

QMenu::item:pressed {
    background-color: @ITEM_PRESS;
}

/* TODO impostare immagine svg appropriata */
QMenu::right-arrow {
    image: url(:/uitheme/controls/dark/TreeViewClose.svg);
    min-width: 40px;
    min-height: 18px;
}

QMenuBar:disabled {
    color: @TEXT_MUTED;
}

QMenu::item:disabled {
    color: @TEXT_MUTED;
    background-color: transparent;
}

/* --- CHECKBOX & RADIO --- */
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @BORDER_INPUT;
    border-radius: 2px;
    background-color: @BG_INPUT;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: @BORDER_FOCUS;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: @ACCENT_BLUE;
    border-color: @ACCENT_LBLUE;
    image: url(@ICON_PREFIX/check.svg); /* Se presente nei tuoi asset */
}

/* --- SLIDERS --- */
QSlider::groove:horizontal {
    height: 4px;
    background: @BORDER_STD;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: @ACCENT_ORANGE;
    width: 12px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 6px;
}

/* --- SCROLLBAR --- */
QScrollBar {
    border-radius: 0;
    font-size: 13pt;
}

QScrollBar:vertical {
    border-left: 1px solid @BORDER_STD;
    width: 10px;
}

QScrollBar:horizontal {
    border-top: 1px solid @BORDER_STD;
    height: 10px;
}

QScrollBar::handle {
    margin: -1px;
    background: @BG_SCROLL;
    border: 1px solid @BORDER_STD;
    border-radius: 4px;
}

QScrollBar::handle:hover {
    background: @BG_BTN_HOVER;
}

QScrollBar::left-arrow, QScrollBar::right-arrow,
QScrollBar::up-arrow, QScrollBar::down-arrow,
QScrollBar::sub-line, QScrollBar::add-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
    height: 0;
    width: 0;
    border: 0;
}

/* --- TAB BAR/NAVIGATION --- */
QTabBar::tab {
    background-color: @BG_HEADER;
    color: @TEXT_MUTED;
    border: none;
    border-right: 1px solid @BORDER_STD;
    padding: 8px 16px;
    min-width: 100px;
    max-width: 200px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: @BG_PANEL;
    color: @TEXT_LIGHT;
    border-bottom: 2px solid @ACCENT_BLUE;
}

QTabBar::tab:hover:!selected {
    background-color: @BG_BTN_HOVER;
    color: @TEXT_LIGHT;
}

QTabBar::tab:!enabled {
    background-color: @BG_APP;
    color: @TEXT_MUTED;
}

/* ========================================================================= */
/* --- MULTIPLE CHANNEL CONTROLS ---                                         */
/* ========================================================================= */

QDockWidget#MultipleChannelControlDockWidget {
    border: none;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QFrame#mainWrapper {
    background-color: @BG_PANEL;
    border: 1px solid @BORDER_PANEL;
    border-top: none;
    border-bottom: none;        
}

QWidget#customTitleBar {
    background-color: @BG_HEADER;
    border: 1px solid @BORDER_PANEL;
    border-top-right-radius: 4px;
    border-top-left-radius: 4px;
}

/* Window Buttons */
QPushButton#windowClose, QPushButton#windowExpand {
    background: transparent;
    color: @TEXT_MUTED;
    border: none;
    width: 8px;
    padding: 2px;
    margin: 0px; 
}

QPushButton#windowExpand { image: url(@ICON_PREFIX/window-restore-regular.svg); }
QPushButton#windowClose { image: url(@ICON_PREFIX/x-solid.svg); }

QPushButton#windowClose:hover, QPushButton#windowExpand:hover {
    background-color: @BORDER_PANEL;
    color: @TEXT_LIGHT;
}

/* Header di sezione */
QLabel#sectionHeader {
    color: @TEXT_SECONDARY;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 1px;
}

QFrame#sectionHeaderContainer {
    background-color: @BG_HEADER;
    height: 18px;
    padding: 8px 8px;
    spacing: 10
}

/* Badge delle proprietà (E, X, P, etc.) */
QLabel#propertyBadge {
    background-color: @ACCENT_BLUE;
    color: @BG_PANEL;
    border-radius: 2px;
    font-weight: bold;
    font-size: 10px;
}

QLabel#propertyBadge[propertyValue="E"] { background-color: @BDG_E_BG; color: @BDG_E_FG; }
QLabel#propertyBadge[propertyValue="P"] { background-color: @BDG_P_BG; color: @BDG_P_FG; }
QLabel#propertyBadge[propertyValue="O"] { background-color: @BDG_O_BG; color: @BDG_O_FG; }
QLabel#propertyBadge[propertyValue="X"] { background-color: @BDG_X_BG; color: @BDG_X_FG; }
QLabel#propertyBadge[propertyValue="C"] { background-color: @BDG_C_BG; color: @BDG_C_FG; }
QLabel#propertyBadge[propertyValue="J"] { background-color: @BDG_C_BG; color: @BDG_C_FG; }
QLabel#propertyBadge[propertyValue="R"] { background-color: @BDG_R_BG; color: @BDG_R_FG; }

/* Status Labels */
QLabel[status="mixed"] {
    background-color: rgba(226, 158, 46, 0.2);
    color: @ACCENT_ORANGE;
    border: 1px solid @ACCENT_ORANGE;
}

QLabel[status="on"] {
    background-color: @BDG_E_BG;
    color: @BDG_E_FG;
    border: 1px solid @BDG_E_FG;
}

/* Switches ed elementi Toggle */
QLabel#activationSwitch { qproperty-alignment: 'AlignCenter'; }
QLabel#activationSwitch[checked="false"] { qproperty-pixmap: url("@ICON_PREFIX/toggle_off.svg"); }
QLabel#activationSwitch[checked="true"] { qproperty-pixmap: url("@ICON_PREFIX/toggle_on.svg"); }

/* Auto Labels */
QLabel#autoLabel { 
    color: @TEXT_SECONDARY; 
    font-size: 10px; 
    font-weight: bold; 
    letter-spacing: 0.5px; 
}
QLabel#autoLabel[active="true"] { color: @ACCENT_LBLUE; }

/* Counters & Titles */
QLabel#selectionCounter {
    background-color: @BG_PANEL; 
    color: @ACCENT_LBLUE;
    padding: 5px;
    font-size: 10px;
    font-weight: bold;
    border: 1px solid @BORDER_PANEL;
    border-top: none;
    
}
QLabel#selectionCounter[empty="true"] { color: @TEXT_MUTED; }

QFrame#propertyContainer {
    border: none;
    border-bottom: 1px solid @BORDER_PANEL;
    margin: 4px; 
    padding: 0 8px;
}

QLabel#propertyName, QLabel#titleLabel {
    color: @TEXT_LIGHT;
    text-transform: uppercase;
}
QLabel#propertyName { font-size: 10px; }
QLabel#titleLabel { font-size: 11px; font-weight: bold; letter-spacing: 1px; }

/* --- SUMMARY --- */
QWidget#summaryContainer {
    background-color: @BG_PANEL;
    border: 1px solid @BORDER_PANEL;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

QWidget#summaryCell[value="P"], QWidget#summaryCell[value="X"], QWidget#summaryCell[value="E"], QWidget#summaryCell[value="O"] {
    border-top: 1px solid @BORDER_PANEL;
}
QWidget#summaryCell[value="P"], QWidget#summaryCell[value="X"] {
    border-left: 1px solid @BORDER_PANEL;
}

QLabel#summaryCellName {
    color: @TEXT_SECONDARY;
    text-transform: uppercase;
    font-size: 9px;
    font-weight: bold;
}

/* Valore cella del Summary */
QLabel#summaryCellValue {
    font-size: 10px;
    font-weight: bold;
}
QLabel#summaryCellValue[status="on"] { color: @BDG_E_FG; }
QLabel#summaryCellValue[status="auto"] { color: @ACCENT_LBLUE; }
QLabel#summaryCellValue[status="offline"] { background: transparent; }

/* Pulsante di Toggle Modalità */
#modeToggleBtn {
    background: transparent;
    color: @TEXT_SECONDARY;
    border: none;
    font-size: 10px;
    padding: 0px 5px;
}
#modeToggleBtn:hover { color: @ACCENT_LBLUE; }

/* Label delle righe Expert */
#offsetRowLabel {
    color: @TEXT_MAIN;
    font-size: 10px;
    margin-left: 4px;
}

QFrame#modeContainer {
    background-color: transparent;
    border: none;
}

/* Pulsanti START/STOP nella modalità Basic */
QFrame#modeContainer QPushButton {
    background-color: @BG_BTN;
    border: 1px solid @BORDER_INPUT;
    border-radius: 3px;
    color: @TEXT_MAIN;
    font-size: 10px;
}
QFrame#modeContainer QPushButton:hover { background-color: @BG_BTN_HOVER; }
QFrame#modeContainer QPushButton:pressed {
    background-color: @BG_BTN_PRESS;
    border-color: @ACCENT_LBLUE;
}

QLabel#infoBox { qproperty-pixmap: url(@ICON_PREFIX/circle-info-solid.svg); }

/* ========================================= */
/* --- SPLASH SCREEN ---                     */
/* ========================================= */

QWidget#splashScreen {
    background-color: @BG_APP;
    color: @TEXT_LIGHT;
}

QLabel#splashTitle {
    font-size: 16px;
    font-weight: bold;
    color: @TEXT_LIGHT;
    letter-spacing: 2px;
}

QLabel#selectionTitle {
    font-size: 14px;
    font-weight: bold;
    color: @TEXT_LIGHT;
    letter-spacing: 2px;
}

QLabel#splashSubtitle {
    font-size: 11px;
    color: @TEXT_SECONDARY;
}

QWidget#splashScreen QProgressBar {
    background-color: @BG_INPUT;
    border: 1px solid @BORDER_STD;
    border-radius: 3px;
    text-align: center;
    color: @TEXT_LIGHT;
    font-weight: bold;
    height: 6px;
}

QWidget#splashScreen QProgressBar::chunk {
    background-color: @ACCENT_BLUE;
    border-radius: 2px;
}


QLabel#logoLabel{
    background: none;
}

QLabel#appNameLbl{
    background: none;
    color: white; 
    font-size: 48px; 
    font-weight: bold; 
    font-family: "Inter", sans-serif;
}

QLabel#appVersionLbl{
    background: none;
    color: #717D96; 
    font-weight: light; 
    font-size: 12px; 
    font-family: "Inter", sans-serif;
}

QLabel#statusLbl{
    background: none;
    color: #CBD2E0; 
    font-size: 12px; 
    font-weight: semi-bold;
    font-family: "Inter", sans-serif;
}

QLabel#copyrightLbl{
    background: none;
    color: #717D96; 
    font-weight: light; 
    font-size: 11px; 
    line-height: 15px; 
    font-family: "Inter", sans-serif;
}

QFrame#SplashContainer {
    border-image: url(:/imgs/splash01.png) 0 0 0 0 stretch stretch;
    border-radius: 15px;     
}

QComboBox {
    background-color: @BG_INPUT; 
    border: 1px solid @BORDER_INPUT;
    border-radius: 2px;
    color: @TEXT_SECONDARY;
    font-size: 11px;
    font-style: italic; 
}

QComboBox QAbstractItemView {
    background-color: @BG_PANEL;
    border-radius: 0px;
    border: 1px solid rgba(255, 255, 255, 8);
    selection-color: @TEXT_LIGHT;
    selection-background-color: @BG_BTN_HOVER;
    padding: 8px 8px;
    font-size: 11px;
}

/* ========================================= */
/* --- CENTRAL PLOTS SCREEN ---              */
/* ========================================= */


#BigPlotCanvas {
    background: @BG_PANEL;
}

#BigPlotChartCanvas QFrame{
    background: @BG_APP;
}


QLabel#deviceConnectedLbl {
    background-color: @BG_PANEL;
    padding: 4px 4px;
    border-radius: 4px;
    max-height: 16px;
    font-family: "Inter", sans-serif;
    font-size: 10px;
}


/* CONNECTING Page of device detector */
QFrame#deviceDetectorWid[state="disconnected"] {
    border-image: url(:/imgs/splash01.png) 0 0 0 0 stretch stretch;
    border-radius: 15px;
}

/* CONNECTED Page of device detector */
QFrame#deviceDetectorWid[state="connected"] {
    border-image: none;
    background: transparent;
}

QPushButton#connectBtn[state="disconnected"] {
    background-color: transparent;
    border: 1px solid @BORDER_INPUT;
    text-align: left;
    padding-left: 10px;
    qproperty-icon: url(@ICON_PREFIX/disconnect_plug.svg); 
}

QPushButton#connectBtn[state="disconnected"]:hover {
    background-color: @ACCENT_RED;
    border-color: @BORDER_FOCUS;
}