/* ========================================================================= */
/* EMCR BASE TEMPLATE STYLESHEET                                             */
/* ========================================================================= */

QWidget {
    color: @TEXT_DEFAULT;
    font-family: "Inter", sans-serif;
    font-size: 10px; 
    outline: none;
}

QMainWindow,
QDockWidget {
    background: @SURFACE_APP; 
}

/* Dialogs are a surface in front of the app, not the app background */
QDialog {
    background: @SURFACE_PANEL;
}

QLabel#dlgExitMsg{
    color: @TEXT_DEFAULT;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#dlgDisconnectBtn{
    background-color: @DANGER;
    color: @TEXT_ON_DANGER;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton#dlgDisconnectBtn:hover { 
    background-color: @DANGER_HOVER;
    border-color: @DANGER;
    color: @TEXT_DEFAULT;
}

QPushButton#dlgCancelBtn{
    color: @TEXT_DEFAULT;
    border: 1px solid @CONTROL_BORDER;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 12px;
}

QPushButton#dlgCancelBtn:hover { background-color: @CONTROL_BG_HOVER; }

/* --- TEXT DENSITY & FONTS --- */

QLabel {
    color: @TEXT_DEFAULT;
    font-size: 10px; 
}

QLabel:disabled {
    color: @TEXT_DISABLED;
}

/* Orange color - use for technical-like data */
QWidget[technical="true"] {
    color: @TEXT_VALUE; 
}

/* --- CONTAINERS --- */

QGroupBox {
    border: 1px solid @BORDER_SUBTLE;
    border-radius: 4px;
    margin-top: 18px;
    font-size: 10px;
    text-transform: uppercase;
    color: @TEXT_SUBTLE;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 3px;
}

QSplitter::handle {
    background-color: @SPLITTER;
}

QSplitter::handle:vertical {
    border-left: none;
    border-bottom: none;
    height: 4px;
    image: url(@ICON_PREFIX/horizontal_splitter.svg);
}

QSplitter::handle:horizontal {
    border-top: none;
    border-bottom: none;
    width: 2px;
    image: url(@ICON_PREFIX/vertical_splitter.svg);
}

QSplitter::handle:hover {
    background-color: @SPLITTER_HOVER;
}

QSplitter::handle:pressed {
    background-color: @SPLITTER_HOVER;
}

/* --- INPUTS & WIDGETS --- */

QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 10px;
    min-height: 20px;
    min-width: 65px;
    max-width: 110px;
    border: 1px solid @FIELD_BORDER;
    border-radius: 4px;
    color: @TEXT_VALUE;
    background-color: @FIELD_BG;
}

/* Combo boxes: same box as the other inputs, different text */
QComboBox {
    border-radius: 2px;
    padding-right: 20px; /* room for the arrow */
    color: @TEXT_SUBTLE;
    font-size: 11px;
    font-style: italic; 
}

/* Arrow like the spin boxes ones, instead of the native button */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 16px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(@ICON_PREFIX/arrow_down.svg);
    width: 10px;
    height: 10px;
}

QComboBox::drop-down:hover {
    background-color: @CONTROL_BG_HOVER;
    border-radius: 2px;
}

QLineEdit:disabled, QDoubleSpinBox:disabled, QSpinBox:disabled, QComboBox:disabled {
    background-color: @CONTROL_BG_DISABLED;
    color: @TEXT_DISABLED;
    border-color: @BORDER_DISABLED;
}


QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: @FIELD_BORDER_FOCUS;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    height: 16px;
    border: none;
    background: transparent;
}

QDoubleSpinBox::up-button, QSpinBox::up-button { subcontrol-position: right; right: 18px; }
QDoubleSpinBox::down-button, QSpinBox::down-button { subcontrol-position: right; right: 4px; }

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(@ICON_PREFIX/arrow_up.svg); width: 10px; height: 10px; padding-top: 1px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(@ICON_PREFIX/arrow_down.svg); width: 10px; height: 10px; padding-bottom: 1px; }

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: @CONTROL_BG_HOVER;
    border-radius: 2px;
}

QListView::item {
    padding: 3px 8px;
    color: @TEXT_DEFAULT;
    border: 1px solid transparent;
    border-radius: 2px;
}

QListView::item:disabled {
    color: @TEXT_DISABLED;
}

QListView::item:alternate {
    background-color: @SURFACE_INSET; 
}

QListView::item:hover {
    background-color: @ROW_HOVER_BG;
    color: @TEXT_DEFAULT;
}

QListView::item:selected:active {
    background-color: @ACCENT_BG;
    color: @TEXT_STRONG;
    border: 1px solid @ACCENT;
}

QListView::item:selected:!active {
    background-color: @ACCENT_BG; 
    color: @TEXT_STRONG;
    border: 1px solid transparent;
}

/* --- BUTTONS --- */
QPushButton {
    background-color: @CONTROL_BG;
    border: 1px solid @CONTROL_BORDER;
    border-radius: 4px;
    padding: 4px 12px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: @CONTROL_BG_HOVER;
    border-color: @CONTROL_BORDER_HOVER;
}

QPushButton:pressed {
    background-color: @CONTROL_BG_PRESS;
    border-color: @CONTROL_BORDER_PRESS;
}

QPushButton:checked {
    background-color: @ACCENT_BG;
    border-color: @CONTROL_BORDER_HOVER;
}

QPushButton:disabled {
    background-color: @CONTROL_BG_DISABLED;
    color: @TEXT_DISABLED;
    border-color: @BORDER_DISABLED;
}

QTabBar::base {
    background-color: @SURFACE_APP;
    border: none;
}

/* --- MENUS & TOOLTIPS --- */
QToolTip {
    background-color: @TOOLTIP_BG;
    color: @TOOLTIP_TEXT;
    border: 1px solid @BORDER_DEFAULT;
    border-radius: 4px;
    padding: 4px;
}

QStatusBar QLabel {
    padding: 4px 8px;
    color: @TEXT_STRONG;
}

QMenuBar {
    background-color: @SURFACE_APP;
    color: @TEXT_DEFAULT;
    padding: 5px;
    border-bottom: 10px solid transparent; /* Top 10px margin for all widgets */
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 10px;
    margin-left: 4px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: @STATE_HOVER;
}

QMenuBar::item:pressed {
    background-color: @STATE_PRESS;
    color: @TEXT_SUBTLE;
}

QMenu {
    background-color: @SURFACE_POPUP;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 1px;
    border: 1px solid @MENU_BORDER;
    border-radius: 4px;
}

QMenu::indicator,
QMenu::icon {
    left: 4px; 
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @FIELD_BORDER;
    border-radius: 2px;
    background-color: @FIELD_BG;
    left: 4px;
}

QMenu::indicator:checked {
    background-color: @SURFACE_INSET;
    image: url(@ICON_PREFIX/check-solid.svg);
}

QMenu::indicator:disabled {
    background-color: @CONTROL_BG_DISABLED;
    image: url(@ICON_PREFIX/check-solid_disabled.svg);
}

QMenu::indicator:unchecked {
    background-color: @SURFACE_INSET;
    border: 1px solid @FIELD_BORDER;
    image: none;
}

QMenu::indicator:hover {
    border-color: @CONTROL_BORDER_HOVER;
}

QMenu::separator {
    height: 1px;
    background-color: @BORDER_DEFAULT;
}

QMenu::item {
    background-color: transparent;
    padding: 5px 15px;
    border-radius: 5px;
    min-width: 60px;
    margin-top: 3px;
    margin-bottom: 3px;
}

QMenu::item:selected {
    background-color: @STATE_HOVER;
}

QMenu::item:pressed {
    background-color: @STATE_PRESS;
}

QMenu::right-arrow {
    image: url(@ICON_PREFIX/arrow_right.svg);
    width: 10px;
    height: 10px;
}

QMenuBar:disabled {
    color: @TEXT_DISABLED;
}

QMenu::item:disabled {
    color: @TEXT_DISABLED;
    background-color: transparent;
}

/* --- CHECKBOX & RADIO --- */
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @FIELD_BORDER;
    background-color: @FIELD_BG;
    border-radius: 2px;
}

QRadioButton::indicator {
    background-color: @FIELD_BG;
    border: 1px solid @FIELD_BORDER;
    border-radius: 8px;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: @CONTROL_BG_DISABLED;
    color: @TEXT_DISABLED;
    border-color: @BORDER_DISABLED;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: @CONTROL_BORDER_HOVER;
}

QRadioButton::indicator:checked{
    background-color: @INDICATOR_CHECKED;
}

QCheckBox::indicator:checked {
    image: url(@ICON_PREFIX/check-solid.svg);
}


/* --- SLIDERS --- */
QSlider::groove:horizontal {
    height: 4px;
    background: @BORDER_SUBTLE;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: @SLIDER_HANDLE;
    width: 12px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 6px;
}

/* ========================================================================= */
/* --- SCROLLBAR ---                                                         */
/* ========================================================================= */


QScrollBar:vertical {
    background: @SCROLL_TRACK;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: @SCROLL_HANDLE;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: @SCROLL_HANDLE_HOVER;
}


QScrollBar::add-page:vertical, 
QScrollBar::sub-page:vertical,
QScrollBar::groove:vertical {
    background: transparent;
    border: none;
}

QScrollBar::sub-line:vertical, 
QScrollBar::add-line:vertical {
    border: none;
    background: transparent;
    height: 0px;
    subcontrol-origin: margin;
}


QScrollBar:horizontal {
    background: @SCROLL_TRACK;
    height: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: @SCROLL_HANDLE;
    min-width: 20px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background-color: @SCROLL_HANDLE_HOVER;
}

QScrollBar::add-page:horizontal, 
QScrollBar::sub-page:horizontal,
QScrollBar::groove:horizontal {
    background: transparent;
    border: none;
}

QScrollBar::sub-line:horizontal, 
QScrollBar::add-line:horizontal {
    border: none;
    background: transparent;
    width: 0px;
    subcontrol-origin: margin;
}

QAbstractScrollArea {
    background-color: transparent;
}
 

/* ========================================================================= */
/* --- TAB BAR - STACKED WIDGETS ---                                         */
/* ========================================================================= */

QMainWindow QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}

/* TAB not selected */
QMainWindow QTabBar::tab {
    background: transparent;
    color: @TEXT_INACTIVE;
    font-weight: 500;
    padding: 4px 12px;
    border: 1px solid @BORDER_DEFAULT;
    border-top: none;
    margin-bottom: 10px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    min-width: 80px;
}

QMainWindow QTabBar::tab:hover {
    background: @CONTROL_BG_HOVER;
    color: @TEXT_STRONG;
}

QMainWindow QTabBar::tab:selected {
    background: @ACCENT_BG;
    color: @TEXT_STRONG;
    border-top: none;
    border-left: 1px solid @BORDER_DEFAULT;
    border-right: 1px solid @BORDER_DEFAULT;
    border-bottom: 1px solid @BORDER_DEFAULT;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

QMainWindow QTabBar::tab:first {
    margin-left: 10px;
}

QMainWindow QTabBar::tab:last {
    margin-right: 10px;
}

QMainWindow QTabBar QToolButton {
    border: 1px solid @CONTROL_BORDER;
    background-color: @CONTROL_BG;
    width: 10px;
    height: 6px;
    border-radius: 2px;
    margin-bottom: 10px;
}

QMainWindow QTabBar QMenu::left-arrow {
    width: 5px;
    height: 5px;
}

QMainWindow QTabBar QMenu::right-arrow {
    width: 5px;
    height: 5px;
}
QMainWindow QTabBar QMenu {
    margin-right: 10px;
}

QMainWindow QTabBar::scroller {
    width: 24px;
}

QTabBar::tear {
    width: 0px; 
    border: none;
}


/* ========================================================================= */
/* --- MULTIPLE CHANNEL CONTROLS ---                                         */
/* ========================================================================= */

QFrame#mainWrapper {
    background-color: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    border-top: none;
    border-bottom: none; 
}

QWidget#customTitleBar {
    background-color: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    border-top: none;

}

QWidget#customFooter {
    background-color: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}


/* Window Buttons */
QPushButton#windowClose, QPushButton#windowExpand {
    background: transparent;
    color: @TEXT_INACTIVE;
    border: none;
    width: 8px;
    padding: 2px;
    margin: 0px; 
}

QPushButton#windowExpand { image: url(@ICON_PREFIX/window-restore-regular.svg); }
QPushButton#windowClose { image: url(@ICON_PREFIX/x-solid.svg); }

QPushButton#windowClose:hover, QPushButton#windowExpand:hover {
    background-color: @WINDOW_BUTTON_HOVER_BG;
    color: @TEXT_STRONG;
}

/* Header */
/* Section caption: small uppercase text on a header band */
QLabel#sectionHeader {
    color: @TEXT_CAPTION;
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.6px;
}

QFrame#sectionHeaderContainer {
    background-color: @SURFACE_HEADER;
    height: 14px;
    padding: 4px 8px 4px 8px;
    spacing: 10
}

/* Properties (E, X, P, etc.) */
QLabel#propertyBadge{
    background-color: @ACCENT;
    color: @TEXT_ON_ACCENT;
    border-radius: 2px;
    font-weight: bold;
    font-size: 10px;
}

QLabel#propertyBadge[propertyValue="E"] { background-color: @BDG_E_BG; color: @BDG_E_FG; }
QLabel#propertyBadge[propertyValue="P"] { background-color: @BDG_P_BG; color: @BDG_P_FG; }
QLabel#propertyBadge[propertyValue="O"] { background-color: @BDG_O_BG; color: @BDG_O_FG; }
QLabel#propertyBadge[propertyValue="X"] { background-color: @BDG_X_BG; color: @BDG_X_FG; }
QLabel#propertyBadge[propertyValue="C"] { background-color: @BDG_C_BG; color: @BDG_C_FG; }
QLabel#propertyBadge[propertyValue="J"] { background-color: @BDG_C_BG; color: @BDG_C_FG; }
QLabel#propertyBadge[propertyValue="R"] { background-color: @BDG_R_BG; color: @BDG_R_FG; }

/* Status Labels */
QLabel[status="mixed"] {
    background-color: @STATUS_WARN_BG;
    color: @STATUS_WARN;
    border: 1px solid @STATUS_WARN;
}

QLabel[status="on"] {
    background-color: @STATUS_OK_BG;
    color: @STATUS_OK;
    border: 1px solid @STATUS_OK;
}

/* Per-property ON/OFF counters: small boxes, they are read at a glance */
QLabel#featureOnCounter{
    background-color: @STATUS_OK_BG;
    color: @STATUS_OK;
    border-radius: 2px;
    font-weight: 600;
    font-size: 10px;
    padding-left: 4px;
    padding-right: 4px;
}

QLabel#featureOffCounter{
    background-color: @STATE_HOVER_SUBTLE;
    color: @TEXT_INACTIVE;
    border-radius: 2px;
    font-weight: 600;
    font-size: 10px;
    padding-left: 4px;
    padding-right: 4px;
}

/* Switches & Toggle - custom switch */
QLabel#activationSwitch { qproperty-alignment: 'AlignCenter'; }
QLabel#activationSwitch[checked="false"] { qproperty-pixmap: url("@ICON_PREFIX/toggle_off.svg"); }
QLabel#activationSwitch[checked="true"] { qproperty-pixmap: url("@ICON_PREFIX/toggle_on.svg"); }

/* AUTO toggle labels */
QLabel#autoLabel { 
    color: @TEXT_SUBTLE; 
    font-size: 10px; 
    font-weight: bold; 
    letter-spacing: 0.5px; 
}
QLabel#autoLabel[active="true"] { color: @TEXT_HIGHLIGHT; }

/* Counters & Titles */
/* Selection counter: caption on the left, count in a pill on the right
   (the Channels overview legend is a different thing: square + text) */
QFrame#selectionCounter {
    background-color: @SURFACE_PANEL; 
    border: 1px solid @BORDER_DEFAULT;
    border-top: none;
}

QLabel#selectionCounterCaption {
    color: @TEXT_CAPTION;
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.6px;
}

QLabel#selectionCounterText {
    background-color: @ACCENT_BG;
    color: @TEXT_STRONG;
    border-radius: 9px;
    padding: 1px 8px;
    font-weight: 600;
}

QLabel#selectionCounterText[empty="true"] {
    background-color: @STATE_HOVER_SUBTLE;
    color: @TEXT_DISABLED;
}

QFrame#propertyContainer {
    border: none;
    margin: 4px; 
    padding: 0 8px;
}

QLabel#propertyName, QLabel#titleLabel {
    color: @TEXT_SUBTLE;
    text-transform: uppercase;
}
QLabel#propertyName { font-size: 10px; }
QLabel#titleLabel { font-size: 11px; font-weight: 600; letter-spacing: 0.5px; color: @TEXT_STRONG; }

/* --- SUMMARY --- */
QWidget#summaryContainer {
    background-color: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

QWidget#summaryCell[value="P"], QWidget#summaryCell[value="X"], QWidget#summaryCell[value="E"], QWidget#summaryCell[value="O"] {
    border-top: 1px solid @BORDER_DEFAULT;
}
QWidget#summaryCell[value="P"], QWidget#summaryCell[value="X"] {
    border-left: 1px solid @BORDER_DEFAULT;
}

QLabel#summaryCellName {
    color: @TEXT_SUBTLE;
    text-transform: uppercase;
    font-size: 9px;
    font-weight: bold;
}

QLabel#summaryCellValue {
    font-size: 10px;
    font-weight: bold;
}
QLabel#summaryCellValue[status="on"] { color: @STATUS_OK; background: transparent; border: none; }
QLabel#summaryCellValue[status="mixed"] { color: @STATUS_WARN; background: transparent; border: none; }
QLabel#summaryCellValue[status="auto"] { color: @TEXT_HIGHLIGHT; }
QLabel#summaryCellValue[status="offline"] { background: transparent; }


/* EXPERT - BASIC mode switch */
#modeToggleBtn {
    background: transparent;
    color: @TEXT_SUBTLE;
    border: none;
    font-size: 10px;
    padding: 0px 5px;
}
#modeToggleBtn:hover { 
    border-left: 1px solid transparent;
    border-radius: 4px;
    background: @CONTROL_BG_HOVER;
    color: @TEXT_HIGHLIGHT; 
}

#offsetRowLabel {
    color: @TEXT_DEFAULT;
    font-size: 10px;
    margin-left: 4px;
}

QFrame#modeContainer {
    background-color: transparent;
    border: none;
}

/* Start/stop buttons in mode container (Basic/expert switch) */
QFrame#modeContainer QPushButton {
    background-color: @CONTROL_BG;
    border: 1px solid @CONTROL_BORDER;
    border-radius: 4px;
    color: @TEXT_DEFAULT;
    font-size: 10px;
}

QFrame#modeContainer QPushButton:hover { background-color: @CONTROL_BG_HOVER; }
QFrame#modeContainer QPushButton:pressed {
    background-color: @CONTROL_BG_PRESS;
    border-color: @CONTROL_BORDER_CHECKED;
}

QLabel#infoBox { 
    qproperty-pixmap: url(@ICON_PREFIX/circle-info-solid.svg);
    qproperty-scaledContents: true;
}


/* ========================================================================= */
/* --- PLOT DETAIL ---                                                       */
/* ========================================================================= */

QWidget#PlotDetail{
    background-color: @SURFACE_PANEL;
}


/* ========================================= */
/* --- SPLASH SCREEN ---                     */
/* ========================================= */

QWidget#splashScreen {
    background-color: @SURFACE_APP;
    color: @TEXT_STRONG;
}

QLabel#splashTitle {
    font-size: 16px;
    font-weight: bold;
    color: @TEXT_STRONG;
    letter-spacing: 2px;
}

QLabel#selectionTitle {
    font-size: 14px;
    font-weight: bold;
    color: @TEXT_STRONG;
    letter-spacing: 2px;
}

QLabel#splashSubtitle {
    font-size: 11px;
    color: @TEXT_SUBTLE;
}

QWidget#splashScreen QProgressBar {
    background-color: @FIELD_BG;
    border: 1px solid @BORDER_SUBTLE;
    border-radius: 3px;
    text-align: center;
    color: @TEXT_STRONG;
    font-weight: bold;
    height: 6px;
}

QWidget#splashScreen QProgressBar::chunk {
    background-color: @ACCENT;
    border-radius: 2px;
}


QLabel#elementsLogo{
   background: none;
   image: url("@IMGS_PREFIX/logo_with_name.png");
}

QLabel#appNameLbl{
    background: none;
    color: @SPLASH_TITLE; 
    font-size: 48px; 
    font-weight: bold; 
    font-family: "Inter", sans-serif;
}

QLabel#appVersionLbl{
    background: none;
    color: @TEXT_CAPTION; 
    font-weight: 300; 
    font-size: 12px; 
    font-family: "Inter", sans-serif;
}

QLabel#statusLbl{
    background: none;
    color: @TEXT_SUBTLE; 
    font-size: 12px; 
    font-weight: 600;
    font-family: "Inter", sans-serif;
}

QLabel#copyrightLbl{
    background: none;
    color: @TEXT_CAPTION; 
    font-weight: 300; 
    font-size: 11px; 
    font-family: "Inter", sans-serif;
}

QFrame#SplashContainer {
    border-image: url(@IMGS_PREFIX/splash/splash01.png) 0 0 0 0 stretch stretch;
    background-color: @SURFACE_APP;
}

QComboBox QAbstractItemView {
    background-color: @SURFACE_POPUP;
    border-radius: 0px;
    border: 1px solid @POPUP_BORDER;
    selection-color: @TEXT_STRONG;
    selection-background-color: @ROW_HOVER_BG;
    padding: 8px 8px;
    font-size: 11px;
}

/* ====================================== */
/* --- PLOTS - QWT                        */
/* ====================================== */

QwtPlotCanvas {
    background: @PLOT_BG;
}


QwtTextLabel {
    color: @TEXT_DEFAULT;
    font-size: 10px;
}


/* ====================================== */
/* --- CENTRAL PLOTS SCREEN - TAB MENU    */
/* ====================================== */

QTabWidget#bigPlotTabWidget {
    background: @SURFACE_PANEL;
}

/* TAB pane within the whole tab frame */
QTabWidget#bigPlotTabWidget::pane {
    background: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    /* pane top on the dock area top (like the side panels): -(tab bar height) */
    margin-top: -41px;
    padding-top: 38px;
    border-radius: 6px;
}


/* Following two rules builds an "hand-made" segmented button */
/* This is the TAB menu container of the segmented button */
QTabWidget#bigPlotTabWidget QTabBar {
    background: @SURFACE_INSET;
    border-radius: 6px;
    margin-top: 10px;
    margin-left: 8px;
    border: 1px solid @SURFACE_INSET;
    padding: 3px;
}

/* TAB buttons - deselected */
QTabWidget#bigPlotTabWidget QTabBar::tab {
    background: transparent;
    color: @TEXT_INACTIVE;
    padding: 6px 14px;
    margin-top: 12px;
    margin-right: 2px;
    margin-bottom: 2px;
    border-radius: 4px;
    border: 1px solid transparent;
}

/* First TAB must be aligned with QTabBar container */
/* In this way other tabs are not separated within each other */
QTabWidget#bigPlotTabWidget QTabBar::tab:first {
    margin-left: 10px;
}

QTabWidget#bigPlotTabWidget QTabBar::tab:selected {
    background-color: @ACCENT_BG;
    color: @TEXT_STRONG;
}

QTabWidget#bigPlotTabWidget QTabBar::tab:hover:!selected {
    background: @STATE_HOVER_SUBTLE;
    color: @TEXT_DEFAULT;
}

QPushButton#startButton {
    qproperty-icon: url(@ICON_PREFIX/start.svg);
    qproperty-iconSize: 14px;
}

QPushButton#stopButton {
    qproperty-icon: url(@ICON_PREFIX/stop.svg);
    qproperty-iconSize: 14px;
}

/* CORNER TAB - Project name. */
QLineEdit#projectNameLbl {
    background-color: @SURFACE_HEADER;
    border-radius: 4px;
    padding: 3px 0px;
    font-family: "Inter", sans-serif;
    font-size: 10px;
    color: @TEXT_SUBTLE;
    min-width: 130px;
}

QLineEdit#projectNameLbl:hover {
    background-color: @STATE_HOVER
}

QLineEdit#projectNameLbl:focus {
    background-color: @FIELD_BG_FOCUS;
}

QLabel#projectNamePrefixLbl {
    font-family: "Inter", sans-serif;
    font-size: 10px;
    color: @TEXT_SUBTLE;
    background: transparent;
}

/* ========================================= */
/* --- GAPFREE ---                           */
/* ========================================= */

QLabel#controlsTitle, QLabel#recordingTitle {
    font-family: "Inter", sans-serif;
    font-size: 10px;
    color: @TEXT_CAPTION;
    font-weight: bold;
    text-transform: uppercase;
}

QPushButton#zoomInBtn {
    background-color: transparent;
    border: none;
    qproperty-icon: url(@ICON_PREFIX/zoom_in.svg);
}

QPushButton#zoomOutBtn {
    background-color: transparent;
    border: none;
    qproperty-icon: url(@ICON_PREFIX/zoom_out.svg);
}

QPushButton#zoomInBtn:hover,
QPushButton#zoomOutBtn:hover {
    background-color: @CONTROL_BG_HOVER;
}

QFrame#lineSeparator {
    height: 0.5px;
    color: @SEPARATOR;
}

/* Manual zoom controls */
QFrame#manualZoomContainer{
    border: 1px solid @BORDER_DEFAULT;
    border-radius: 4px;
}

QPushButton#btnSelectAxes::menu-indicator{
    subcontrol-position: right center;
    margin-right: 2px;
    width: 8px;
    height: 8px;
}

/* ========================================= */
/* --- RECORDING WIDGET ---                  */
/* ========================================= */

QPushButton#btnSettings {
    qproperty-icon: url(@ICON_PREFIX/settings.svg);
    qproperty-iconSize: 14px;
}

QPushButton#locationBtn,
QPushButton#recordingsBtn,
QPushButton#autoZoom,
QPushButton#btnSelectAxes,
QPushButton#advRecordingSettings{
    color: @TEXT_SUBTLE;
    text-transform: uppercase;
    font-size: 10px;
}

QPushButton#locationBtn {
    qproperty-icon: url(@ICON_PREFIX/directory_settings.svg);
    qproperty-iconSize: 16px;
}

QPushButton#recordingsBtn {
    qproperty-icon: url(@ICON_PREFIX/directory_open.svg);
    qproperty-iconSize: 16px;
}

QPushButton#autoZoom {
    qproperty-icon: url(@ICON_PREFIX/zoom_full.svg);
    text-transform: uppercase;
}

QPushButton#advRecordingSettings {
    qproperty-icon: url(@ICON_PREFIX/extra_settings.svg);
    text-transform: uppercase;
}

/* Icons for record settings */
QLabel#fileIco {
    qproperty-pixmap: url("@ICON_PREFIX/filename.svg");
}

QLabel#recordIco {
    qproperty-pixmap: url("@ICON_PREFIX/folder.svg");
}

/* ========================================= */
/* --- EVENT DETECTION ---                   */
/* ========================================= */

QWidget#statsContainer {
    background: @SURFACE_INSET;
    border: 1px solid @BORDER_DEFAULT;
    border-radius: 4px;
    max-width: 300px;
}

QLabel#statsLbl{
    font-size: 10px;
    color: @TEXT_SUBTLE;
    font-weight: 400;
}

QLabel#statsVal{
    font-size: 10px;
    font-weight: 600;
}


/* ========================================= */
/* --- CONNECTION DEVICE  ---                */
/* ========================================= */

QComboBox#deviceCombo{
    width: 195px;
}

QLabel#deviceConnectedLbl {
    background-color: @CONTROL_BG;
    padding: 5px 7px;
    border-radius: 4px;
    height: 16px;
    font-family: "Inter", sans-serif;
    font-size: 10px;
    color: @TEXT_SUBTLE;
}

QLabel#deviceConnectedTitle{
    font-family: "Inter", sans-serif;
    font-size: 10px;
    color: @TEXT_SUBTLE;
    font-weight: bold;
    text-transform: uppercase;
}

/* CONNECTING Page of device detector */
QFrame#deviceDetectorWid[page="connecting"] {
    border-image: url(@IMGS_PREFIX/splash/splash01.png) 0 0 0 0 stretch stretch;
}

/* CONNECTED Page of device detector */
QFrame#deviceDetectorWid[page="connected"] {
    border-image: none;
    background: @SURFACE_APP;
}

/* Connected device: a panel like the docks below */
QFrame#connectedPage {
    /* like the docks: top on the dock area top, sides 10px, bottom 10px before the next dock */
    margin: 0px 10px 10px 10px;
    background: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    border-radius: 6px;
}

QPushButton#disconnectBtn {
    background-color: @CONTROL_BG;
    border: 1px solid @CONTROL_BORDER;
    qproperty-icon: url(@ICON_PREFIX/disconnect_plug.svg); 
}

QPushButton#disconnectBtn:hover {
    background-color: @DANGER_HOVER;
    border-color: @DANGER;
    color: @TEXT_DEFAULT;
}

QLabel#connectionSpeed {
    font-size: 11px;
    color: @TEXT_CAPTION; 
}

QLabel#deviceIco { qproperty-pixmap: url("@ICON_PREFIX/device_ico.svg"); }

QTabBar {
    background: @SURFACE_APP;
}

QMainWindow::separator {
    background-color: @SURFACE_APP;
    width: 3px;
    height: 3px; 
    border: none;
}

QMainWindow::separator:hover {
    background-color: @SEPARATOR_HOVER; 
}


/* ========================================= */
/* --- NOTIFICATIONS ---                     */
/* ========================================= */

/* Status in the menu bar corner (bell + text) */
QFrame#notificationStatus {
    background: transparent;
    border: none;
    border-radius: 4px;
    margin-right: 6px;
}

QFrame#notificationStatus:hover {
    background-color: @STATE_HOVER;
}

QLabel#notificationStatusText {
    color: @TEXT_SUBTLE;
    spacing: 10;
    text-transform: uppercase;
    font-size: 9px;
    font-weight: bold;
}

/* The bell takes the same color of the text */
#notificationStatusText[level="OK"]      {color: @TEXT_SUBTLE;}
#notificationStatusText[level="INFO"]    {color: @STATUS_INFO;}
#notificationStatusText[level="WARNING"] {color: @STATUS_WARN;}
#notificationStatusText[level="ERROR"]   {color: @STATUS_ERROR;}

/* Popup */
QFrame#notificationPopup {
    background-color: @SURFACE_POPUP;
    border: 1px solid @BORDER_DEFAULT;
    border-radius: 4px;
}

QPushButton#notificationTabBtn {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    color: @TEXT_INACTIVE;
    font-size: 11px;
    padding: 4px 6px;
}

QPushButton#notificationTabBtn:hover {
    color: @TEXT_DEFAULT;
}

QPushButton#notificationTabBtn:checked {
    color: @TEXT_DEFAULT;
    border-bottom: 2px solid @ACCENT;
}

QPushButton#notificationLinkBtn {
    background: transparent;
    border: none;
    color: @TEXT_LINK;
    font-size: 11px;
    padding: 4px 2px;
}

QPushButton#notificationLinkBtn:hover {
    text-decoration: underline;
}

QPushButton#notificationLinkBtn:disabled {
    color: @TEXT_DISABLED;
}

QScrollArea#notificationScrollArea {
    background: transparent;
    border: none;
}

QWidget#notificationContainer {
    background: transparent;
}

QLabel#notificationEmptyLbl {
    color: @TEXT_INACTIVE;
    font-size: 11px;
    padding: 16px;
}

/* Single notification */
QFrame#notificationItem {
    background-color: @SURFACE_APP;
    border: 1px solid @BORDER_DEFAULT;
    border-radius: 4px;
}

QFrame#notificationItem[read="false"] {
    background-color: @SURFACE_HEADER;
}

QFrame#notificationItem:hover {
    background-color: @ROW_HOVER_BG;
}

QLabel#notificationText {
    color: @TEXT_SUBTLE;
    font-size: 11px;
}

QLabel#notificationText[read="false"] {
    font-weight: 400;
}

/* Border and text colored by severity */
#notificationItem[level="INFO"]    {border: 1px solid @STATUS_INFO;}
#notificationItem[level="WARNING"] {border: 1px solid @STATUS_WARN;}
#notificationItem[level="ERROR"]   {border: 1px solid @STATUS_ERROR;}

#notificationText[level="INFO"]    {color: @STATUS_INFO;}
#notificationText[level="WARNING"] {color: @STATUS_WARN;}
#notificationText[level="ERROR"]   {color: @STATUS_ERROR;}

QLabel#notificationTime {
    color: @TEXT_INACTIVE;
    font-size: 10px;
}

QLabel#notificationDot {
    font-size: 10px;
}

#notificationDot[level="INFO"]    {color: @STATUS_INFO;}
#notificationDot[level="WARNING"] {color: @STATUS_WARN;}
#notificationDot[level="ERROR"]   {color: @STATUS_ERROR;}

QPushButton#closeNotificationBtn {
    background: transparent;
    border: none;
    color: @TEXT_INACTIVE;
    font-weight: bold;
    font-size: 11px;
    min-height: 14px;
    padding: 0px 4px;
}

QPushButton#closeNotificationBtn:hover {
    color: @TEXT_STRONG;
    background-color: @CONTROL_BG_HOVER;
    border-radius: 2px;
}

/* ========================================= */
/* --- CHESSBOARD / CHANNELS OVERVIEW ---    */
/* ========================================= */

QWidget#gridContainer{
    background: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    border-top: none;
    border-bottom: none;
}

QWidget#stampPlotCard[status="default"] {
    background-color: @BG_STAMP;
    border-radius: 6px;
    border: 1px solid @BORDER_STAMP;
}

QWidget#stampPlotCard[status="selected"] {
    background-color: @BG_STAMP_SEL;
    border: 2px solid @ACCENT;
    border-radius: 6px;
}

/* Canvas with the same solid color as the card */
QWidget#stampPlotCanvas {
    background-color: @BG_STAMP;
}

QWidget#stampPlotCard[status="selected"] QWidget#stampPlotCanvas {
    background-color: @BG_STAMP_SEL;
}

QLabel#selectedChBox {
    background: @INDICATOR_CHECKED;
    border: 1px solid @ACCENT;
    border-radius: 2px;
}

QLabel#selectedChLabel,
QLabel#totalChannelsLabel {
    color: @TEXT_SUBTLE;
}

/* ========================================= */
/* --- FLOATING WIDGET BORDER MANAGEMENT --- */
/* ========================================= */

/* Docks floating: the window already has its own border, so some inner
   borders are removed. QDockWidget's own "floating" property is used, but Qt
   does not re-evaluate these rules when a dock is floated or docked: the
   widgets involved are marked "floatingAware" and re-polished by
   MainWindow::setDockWidget */

/* CHANNELS OVERVIEW */
QDockWidget#chessboard[floating="true"] #gridContainer {
    border: none;
}

QDockWidget#chessboard[floating="true"] #customTitleBar {
    border-left: none;
    border-right: none;
}

QDockWidget#chessboard[floating="true"] #customFooter {
    border-left: none;
    border-right: none;
    border-bottom: none;
}

/* DEVICE CONTROLS */
QDockWidget#deviceControlsDw[floating="true"] #deviceControlsScrollContainer {
    border: none;
}

QDockWidget#deviceControlsDw[floating="true"] #filterHeaderOutput {
    border-bottom: none;
    border-left: none;
    border-right: none;
}

QDockWidget#deviceControlsDw[floating="true"] #samplingHeaderOutput {
    border-left: none;
    border-right: none;
}

/*  MULTIPLECHANNEL */
QDockWidget#multipleChannelControlsDw[floating="true"] #mainWrapper,
QDockWidget#multipleChannelControlsDw[floating="true"] #customFooter,
QDockWidget#multipleChannelControlsDw[floating="true"] #summaryContainer,
QDockWidget#multipleChannelControlsDw[floating="true"] #selectionCounter {
    border: none;
}

/*  SINGLECHANNEL */
QDockWidget#singleChannelControlsDw[floating="true"] #operationHeader,
QDockWidget#singleChannelControlsDw[floating="true"] #operationContainer,
QDockWidget#singleChannelControlsDw[floating="true"] #operationButtonWidget,
QDockWidget#singleChannelControlsDw[floating="true"] #singleChannelControlsScrollContainer {
    border-left: none;
    border-right: none;
}

QDockWidget#singleChannelControlsDw[floating="true"] #customFooter {
    border-left: none;
    border-right: none;
    border-bottom: none;
}


/* VOLTAGEPROTOCOLS */
QDockWidget#protocolDw[floating="true"] #crudButtonsBar,
QDockWidget#protocolDw[floating="true"] #actionBar,
QDockWidget#protocolDw[floating="true"] ProtocolList,
QDockWidget#protocolDw[floating="true"] #ProtocolPropertyDialog {
    border-left: none;
    border-right: none;
}

/* AUTODECLOGGER */
QDockWidget#autoDeclogger[floating="true"] #autodecloggerScrollContainer {
    border: none;
}

QDockWidget#autoDeclogger[floating="true"] QFrame#sectionHeaderContainer[dockSides="true"] {
    border-left: none;
    border-right: none;
}

QDockWidget#autoDeclogger[floating="true"] #poreHeaderContainer {
    border-bottom: none; 
    border-left: none; 
    border-right: none;
}


/* ========================================= */
/* --- APP DOCK WIDGETS WINDOW BAR ---       */
/* ========================================= */

/* Custom dockwidget title label */
QDockWidget{
    font-family: "Inter", sans-serif;
    font-size: 10px; 
    color: @TEXT_SUBTLE;
    font-weight: bold;
    text-transform: uppercase;
    margin-bottom: 10px;
    border: none;
    titlebar-normal-icon: url(@ICON_PREFIX/window-restore-regular.svg);
    titlebar-close-icon: url(@ICON_PREFIX/x-solid.svg);
}

/* Custom dockwidget title bar */
QDockWidget::title {
    background-color: @SURFACE_PANEL;
    margin-left: 10px;
    margin-right: 10px;
    padding-right: 10px;
    padding-left: 4px;
    padding-top: 6px;
    subcontrol-origin: margin;
    subcontrol-position: bottom left;
    border: 0.5px solid @BORDER_DEFAULT;
    border-top-right-radius: 4px;
    border-top-left-radius: 4px;
}

QDockWidget::close-button {
    border: 1px solid transparent;
    border-radius: 2px;
    background: @CONTROL_BG;
    subcontrol-origin: margin;
    subcontrol-position: bottom right;
    top: -5px;
    right: 18px;
}

QDockWidget::float-button {
    border: 1px solid transparent;
    background: @CONTROL_BG;
    border-radius: 2px;
    subcontrol-origin: margin;
    subcontrol-position: bottom right;
    top: -5px;
    right: 38px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: @CONTROL_BG_HOVER;
}



/* ========================================================================= */
/* --- DEVICE CONTROLS  ---                                                  */
/* ========================================================================= */

QWidget#deviceControlsCentralWidget{
    margin: 10px;
    background: @SURFACE_PANEL;
}

QFrame#deviceControlsScrollContainer {
    border: 1px solid @BORDER_DEFAULT;
    background: @SURFACE_PANEL;
    border-top: none;
    border-bottom: none;
}

QWidget#deviceControlsCentralWidget QToolButton {
    border: none;
    width: 10px;
    height: 10px;
}

QWidget#deviceControlsCentralWidget QToolButton {
    image: url(@ICON_PREFIX/arrow_right.svg);
}

QWidget#deviceControlsCentralWidget QToolButton:disabled {
    image: url(@ICON_PREFIX/arrow_right_disabled.svg);
}

QWidget#deviceControlsCentralWidget QToolButton:open {
    image: url(@ICON_PREFIX/arrow_down.svg);
}


QLabel#deviceFinalOutputLbl {
    color: @TEXT_SUBTLE;
    text-transform: uppercase;
    font-size: 9px;
    font-weight: bold;
}

QFrame#filterHeaderOutput,
QFrame#samplingHeaderOutput {
    color: @TEXT_SUBTLE;
    border: 1px solid @BORDER_DEFAULT;
    background-color: @SURFACE_PANEL;
    height: 14px;
    padding: 8px 8px;
    spacing: 10;
    text-transform: uppercase;
    font-size: 9px;
    font-weight: bold;
}

QFrame#samplingHeaderOutput {
    border-bottom: none;
}

QFrame#filterHeaderOutput {
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

QLabel#finalBandwidthLbl,
QLabel#finalSamplingRateLbl {
    color: @TEXT_HIGHLIGHT;
    font-weight: bold;
}

/* Used when Digital Filter is forced off */
QWidget#filterSectionContainer QComboBox:disabled,
QWidget#filterSectionContainer QDoubleSpinBox:disabled {
    background: @CONTROL_BG_DISABLED;
}


/* ---  COLLAPSIBLE SECTION --- */

QRadioButton#collapsibleRowButton {
    background-color: @SURFACE_PANEL;
    border: 1px solid @CONTROL_BORDER;
    border-radius: 4px;
    padding: 0px;
    margin-bottom: 4px;
    min-height: 26px;
}


QRadioButton#collapsibleRowButton::indicator {
    width: 0px;
    height: 0px;
    border: none;
    background: transparent;
    image: none;
}

QRadioButton#collapsibleRowButton:hover {
    background-color: @CONTROL_BG_HOVER;
    border-color: @CONTROL_BORDER_HOVER;
}

QRadioButton#collapsibleRowButton:checked {
    background-color: @CONTROL_BG_PRESS;
    border: 1px solid @ACCENT;
}


QRadioButton#collapsibleRowButton QLabel#rowLabelText {
    color: @TEXT_SUBTLE;
    font-size: 11px;
    font-weight: normal;
    background: transparent;
}

QRadioButton#collapsibleRowButton:checked QLabel#rowLabelText {
    color: @TEXT_DEFAULT;
    font-weight: bold;
}

QRadioButton#collapsibleRowButton QLabel#rowLabelValue {
    color: @TEXT_SUBTLE;
    font-size: 11px;
    font-weight: normal;
    background: transparent;
}

QRadioButton#collapsibleRowButton:checked QLabel#rowLabelValue {
    color: @TEXT_HIGHLIGHT;
    font-weight: bold;

}

QLabel#collapsibleTitleValue {
    color: @TEXT_HIGHLIGHT;        
    font-size: 11px;
    font-weight: bold;
    margin-right: 6px;      
}

QLabel#collapsibleTitle {
    color: @TEXT_DEFAULT;        
    font-size: 11px;
}

QLabel#collapsibleTitle:disabled {
    color: @TEXT_DISABLED;
    font-weight: normal;
}

QLabel#collapsibleTitleValue:disabled {
    color: @TEXT_DISABLED;
    font-weight: normal;
}


/* ========================================================================= */
/* --- BOARD CONTROLS  ---                                                   */
/* ========================================================================= */

#boardControlsMainWg {
    background-color: @SURFACE_PANEL;
}

#boardControlsMainWg QScrollArea, 
#boardControlsMainWg #scrollWg {
    background: transparent;
}


/* ========================================================================= */
/* --- MEASUREMENTS  ---                                                     */
/* ========================================================================= */


#measurementsOverviewDW {
    background-color: @SURFACE_PANEL;
}

#measurementsOverviewDW QWidget#customTitleBar{
    border-bottom: none;
}

#measurementsOverviewDW QScrollArea {
    background: transparent;
}

QFrame#measurementsScrollContainer{
    background: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    border-top: none;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

QLabel#emptyStateLabel {
    font-weight: 300;
    font-size: 8px;
    font-style: italic; 
    color: @TEXT_SUBTLE;
    margin-left: 10px;
}

QTableWidget {
    gridline-color: @BORDER_DEFAULT;
    background-color: @SURFACE_INSET;
    border: 1px solid transparent;
    border-radius: 4px;
}

QTableView{
    border: 1px solid @BORDER_DEFAULT;
    border-radius: 4px;
    alternate-background-color: @SURFACE_PANEL;
}

QTableView QTableCornerButton::section {
    background: @TABLE_HEADER_BG;
    color: @TABLE_HEADER_TEXT;
}

QTableView::item:selected {
    background-color: @ROW_SELECTED_BG;
    color: @TEXT_DEFAULT;
}

QTableView::item:hover {
    background-color: @STATE_HOVER;
}

QHeaderView::section {
    background-color: @TABLE_HEADER_BG;
    color: @TABLE_HEADER_TEXT;
    font-weight: 400;
}

/* Sections of the selected rows/columns: solid, the header has no background
   of its own below the section (a translucent overlay showed up almost black) */
QHeaderView::section:checked {
    background-color: @ROW_SELECTED_BG;
}

QHeaderView#tableVHeader {
    background: transparent;
}

QWidget#scrollWidget{
    border: 1px solid transparent;
    border-top: none;
    background: transparent;
    margin: 6px;
    border-radius: 4px;
}


QPushButton#exportCsvButton{
    qproperty-icon: url(@ICON_PREFIX/export_csv.svg);
    qproperty-iconSize: 14px;
    text-transform: uppercase;
}

QPushButton#copyButton{
    qproperty-icon: url(@ICON_PREFIX/copy.svg);
    text-transform: uppercase;
}

QPushButton#startRecordingButton{
    qproperty-icon: url(@ICON_PREFIX/record.svg);
    qproperty-iconSize: 10px;
    color: @TEXT_SUBTLE;
    text-transform: uppercase;
    font-size: 10px;
}

QPushButton#startRecordingButton[running="true"] {
    qproperty-icon: url(@ICON_PREFIX/stop.svg);
    qproperty-iconSize: 10px;
}


/* ========================================================================= */
/* --- SINGLE CHANNEL CONTROLS ---                                           */
/* ========================================================================= */

QFrame#operationHeader{
    background: @SURFACE_PANEL;
    border-left: 1px solid @BORDER_DEFAULT;
    border-right: 1px solid @BORDER_DEFAULT;
    border-bottom: 0.5px solid @BORDER_SUBTLE;
}

QFrame#operationHeader QLabel {
    color: @TEXT_SUBTLE; 
    font-size: 10px; 
    font-weight: bold; 
    letter-spacing: 0.5px; 
}

QDockWidget#singleChannelControlsDw{
    background: @SURFACE_PANEL;
}

QFrame#singleChannelControlsScrollContainer{
    background: @SURFACE_PANEL;
    border-left: 1px solid @BORDER_DEFAULT;
    border-right: 1px solid @BORDER_DEFAULT;
}

QFrame#operationContainer{
    background-color: @SURFACE_PANEL;
    height: 14px;
    padding: 5px 0px;
    border-right: 1px solid @BORDER_DEFAULT;
    border-left: 1px solid @BORDER_DEFAULT;
    border-bottom: 1px solid @BORDER_DEFAULT;
}

QComboBox#operationCbx{
    max-width: 200px;
    min-width: 100px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    padding-right: 20px;
    border: 1px solid @FIELD_BORDER;
    border-radius: 4px;
    color: @TEXT_VALUE;
    background-color: @FIELD_BG;
}

QComboBox#operationCbx QAbstractItemView {
    background-color: @SURFACE_POPUP;
    border-radius: 2px;
    border: 1px solid @POPUP_BORDER;
    selection-color: @TEXT_STRONG;
    selection-background-color: @ROW_HOVER_BG;
    padding: 8px 8px;
    font-size: 11px;
}

QWidget#operationButtonWidget {
    background-color: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    border-bottom: 2px solid @SURFACE_PANEL;
    padding-top: 4px;
}

QListView {
    background-color: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    border-radius: 4px;
    padding: 4px;
}

/* Scrolling content: inset, like the other content areas */
ProtocolList {
    background-color: @SURFACE_PANEL;
}

/* Edge shadows of the scroll areas (ScrollShadow::install): shown only when
   there is more content in that direction */
QWidget#scrollShadowTop {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @SCROLL_SHADOW, stop:1 transparent);
}

QWidget#scrollShadowBottom {
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0, stop:0 @SCROLL_SHADOW, stop:1 transparent);
}


/* ========================================================================= */
/* --- QUESTION MARK - MENUS ---                                             */
/* ========================================================================= */

QTextBrowser {
    background-color: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    border-radius: 4px;
    padding: 4px;
    font-family: "Inter", sans-serif;
}

/* ========================================================================= */
/* --- AUTODECLOGGER ---                                                     */
/* ========================================================================= */

QLabel#activateBtnLbl{
    color: @TEXT_SUBTLE; 
    font-size: 10px;
    font-weight: bold; 
    letter-spacing: 0.5px; 
}

QLabel#activateBtnLbl[active="true"] { color: @TEXT_HIGHLIGHT; }

QFrame#poreHeaderContainer {
    color: @TEXT_SUBTLE;
    border: 1px solid @BORDER_DEFAULT;
    background-color: @SURFACE_PANEL;
    height: 14px;
    padding: 8px 8px;
    spacing: 10;
    text-transform: uppercase;
    font-size: 9px;
    font-weight: bold;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

/* "Activate" header: section header with the dock side borders (docked only) */
QFrame#sectionHeaderContainer[dockSides="true"] {
    border-left: 1px solid @BORDER_DEFAULT;
    border-right: 1px solid @BORDER_DEFAULT;
}

QFrame#autodecloggerScrollContainer {
    border: 1px solid @BORDER_DEFAULT;
    background: @SURFACE_PANEL;
    border-top: none;
    border-bottom: none;
}

QLabel#poreOutputLbl {
    color: @TEXT_SUBTLE;
    text-transform: uppercase;
    font-size: 9px;
    font-weight: bold;
}

QLabel#poreStatusLbl {
    color: @TEXT_HIGHLIGHT;
    font-weight: bold;
}

/* ========================================================================= */
/* --- VOLTAGE PROTOCOLS ---                                                 */
/* ========================================================================= */

QWidget#crudButtonsBar{
    background-color: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    border-top: none;
}

QWidget#actionBar{
    background-color: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    border-top: none;
    border-bottom: none;
}

/* Menu buttons icons */
QPushButton#addProtocolBtn{
    qproperty-icon: url(@ICON_PREFIX/plus.svg);
}

QPushButton#removeProtocolBtn{
    qproperty-icon: url(@ICON_PREFIX/minus.svg);
}

QPushButton#editProtocolBtn{
    qproperty-icon: url(@ICON_PREFIX/edit.svg);
}

QPushButton#copyProtocolBtn{
    qproperty-icon: url(@ICON_PREFIX/copy.svg);
}

QPushButton#setProtocolsShortCutsBtn{
    qproperty-icon: url(@ICON_PREFIX/shortcut.svg);
}

QPushButton#importProtocolBtn{
    qproperty-icon: url(@ICON_PREFIX/import.svg);
}

/* Special icons below - need to manually increase size */
QPushButton#exportProtocolBtn{
    qproperty-icon: url(@ICON_PREFIX/export.svg);
    qproperty-iconSize: 19px;
}

QPushButton#startStopBtn {
    qproperty-icon: url(@ICON_PREFIX/start.svg);
    qproperty-iconSize: 14px;
}

QPushButton#startStopBtn[running="true"] {
    qproperty-icon: url(@ICON_PREFIX/stop.svg);
    qproperty-iconSize: 14px;
}

/* Simulating a segmented button */
QPushButton#btnAcquisition,
QPushButton#btnAnalysis {
    padding: 2px 4px;
    border-color: transparent;
    border-radius: 0px;
}

QPushButton#btnAcquisition:checked,
QPushButton#btnAnalysis:checked {
    background-color: @ACCENT_BG;
    font-weight: bold;
}

QPushButton#btnAcquisition {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    border-right: none;
}

QPushButton#btnAnalysis {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-left: none;
}

/* ========================================================================= */
/* --- VOLTAGE PROTOCOLS - DIALOGS                                           */
/* ========================================================================= */


#ProtocolPropertyDialog {
    background: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

#VoltageProtocolList,
#AnalysisVoltageProtocolList {
    border-top: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}


/* ========================================================================= */
/* --- VOLTAGE PROTOCOLS - TIMER                                             */
/* ========================================================================= */


/* Internal timer number */
QLCDNumber { 
    color: @LCD_FG;  
    background-color: transparent; 
    border: none;

}

QLCDNumber:disabled { 
    color: @LCD_FG_DISABLED; 
}

/* Timer container - background */
TimerDisplay {
    background-color: @LCD_BG; 
    border: 1px solid @LCD_BORDER;
    border-radius: 2px;
}

QLabel#recordingIcon{
    qproperty-pixmap: url("@ICON_PREFIX/recording.svg");
}

QFrame#recordingIconIdle{
    margin: 1px;
    background-color: @RECORD;
    border-radius: 4px;
}


ColorSelectionButton {
    color: @TEXT_DEFAULT;
    font-weight: bold;
    padding: 4px;
}


/* ========================================================================= */
/* --- COMPENSATION CONTROLS                                                 */
/* ========================================================================= */

QFrame#compensationControlsScrollContainer{
    background: @SURFACE_INSET;
    border-left: 1px solid @BORDER_DEFAULT;
    border-right: 1px solid @BORDER_DEFAULT;
}

/* ========================================================================= */
/* --- TEMPERATURE WIDGET ---                                                */
/* ========================================================================= */
QDockWidget#temperatureSensorDw{
    background: @SURFACE_PANEL;
}

QFrame#tempTableHeader{
    background: @SURFACE_INSET;
    border-left: 1px solid @BORDER_DEFAULT;
    border-right: 1px solid @BORDER_DEFAULT;
    border-bottom: 0.5px solid @BORDER_DEFAULT;
}

QFrame#tempTableHeader QLabel {
    color: @TEXT_SUBTLE; 
    font-size: 10px; 
    font-weight: bold; 
    letter-spacing: 0.5px; 
}

QFrame#tempRowFrame {
    background-color: @SURFACE_INSET;
    border-left: 1px solid @BORDER_DEFAULT;
    border-right: 1px solid @BORDER_DEFAULT;
    border-bottom: 0.5px solid @BORDER_DEFAULT;
}

QLabel#tempValueLbl[status="DEF"],
QLabel#tempValueLbl[status="NOR"] {
    background-color: @BDG_NOR_BG;
    color: @BDG_NOR_FG;
    border: 1px solid @BDG_NOR_FG;
}

QLabel#tempValueLbl[status="WAR"] {
    background-color: @BDG_WAR_BG;
    color: @BDG_WAR_FG;
    border: 1px solid @BDG_WAR_FG;
}

QLabel#tempValueLbl[status="DNG"] {
    background-color: @BDG_DNG_BG;
    color: @BDG_DNG_FG;
    border: 1px solid @BDG_DNG_FG;
}

QFrame#controlsSectionContainer {
    background: @SURFACE_PANEL;
    border: 1px solid @BORDER_DEFAULT;
    border-top: none;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

/* ========================================================================= */
/* --- STATE ARRAY ---                                                       */
/* ========================================================================= */

QFrame#smallHeaderContainer {
    background-color: @SURFACE_PANEL;
    height: 12px;
    padding: 0px 4px;
    spacing: 6
}

QLabel#numberOfStates,
QSpinBox#stateSpinbox {
    background-color: @SURFACE_HEADER;
    padding: 6px 7px;
    border-radius: 4px;
    height: 12px;
    font-family: "Inter", sans-serif;
    font-size: 10px;
    color: @TEXT_SUBTLE;
}

QSpinBox#stateSpinbox {
    width: 130px;
}

QPushButton#deleteStateButton,
QPushButton#insertStateButton {
    width: 80px;
}

