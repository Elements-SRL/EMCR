/* TODO importare Palette colori da Figma */

QWidget {
    color: #D0D0D0;
    font-family: "Inter", sans-serif;
    font-size: 10px; 
    outline: none;
}



QMainWindow, QDialog {
    background-color: #29282E; 
}

/* --- TEXT DENSITY & FONTS --- */
QLabel:disabled {
    color: #606060;
}

/* Valori Numerici e Dati (Inria Sans per un look tecnico) */
QWidget[technical="true"] {
    font-family: "Inria Sans";
    font-size: 13px;
    color: #E29E2E; /* Test arancio - alto contrasto */
}

/* --- CONTAINERS --- */

QGroupBox {
    border: 1px solid #333333;
    border-radius: 4px;
    margin-top: 18px;
    font-size: 10px;
    text-transform: uppercase;
    color: #777777;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 3px;
}

/* --- INPUTS & WIDGETS --- */

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #121212;
    border: 1px solid #383838;
    border-radius: 2px;
    padding: 3px 5px;
    color: #E29E2E;
    selection-background-color: #E29E2E;
    selection-color: #1A1A1A;
}

QLineEdit:focus, QSpinBox:focus {
    border-color: #555555;
}

/* --- BUTTONS --- */

QPushButton {
    background-color: #333333;
    border: 1px solid #454545;
    border-radius: 3px;
    padding: 4px 12px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #3D3D3D;
    border-color: #555555;
}

QPushButton:pressed {
    background-color: #1A1A1A;
    border-color: #E29E2E;
}

QPushButton:checked {
    background-color: #2a4a6a;
    border-color: #3a6a9a;
}

QPushButton:disabled {
    background-color: #2d2d2d;
    color: #606060;
    border-color: #444444;
}


/* --- TAB BAR/NAVIGATION --- */

QTabBar::tab {
    background-color: #2d2d2d;
    color: #b0b0b0;
    border: none;
    border-right: 1px solid #333333;
    padding: 8px 16px;
    min-width: 100px;
    max-width: 200px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #3d3d3d;
    color: #ffffff;
    border-bottom: 2px solid #007acc;
}

QTabBar::tab:hover:!selected {
    background-color: #353535;
    color: #ffffff;
}

QTabBar::tab:!enabled {
    background-color: #252525;
    color: #606060;
}


/* --- TABLES & GRIDS --- */

QHeaderView::section {
    background-color: #1A1A1A;
    color: #666666;
    padding: 2px;
    border: 1px solid #2A2A2A;
    font-size: 10px;
}

QTableWidget {
    gridline-color: #2A2A2A;
    background-color: #1E1E1E;
    alternate-background-color: #232323;
    selection-background-color: #333333;
    border: 1px solid #333333;
}


/* --- SCROLLBAR --- */

QScrollBar {
  border-radius: 0;
  font-size: 13pt;
}

QScrollBar:vertical {
  border-left: 1px solid #1c1c1c;
  width: 10px;
}

QScrollBar:horizontal {
  border-top: 1px solid #1c1c1c;
  height: 10px;
}

QScrollBar::handle {
  margin: -1px;
  background: #666;
  border: 1px solid #1c1c1c;
  border-radius: 4px;
}

QScrollBar::handle:vertical {
  min-height: 40px;
}

QScrollBar::handle:horizontal {
  min-width: 40px;
}

QScrollBar::handle:hover {
  background: #888;
}

QScrollBar::left-arrow,
QScrollBar::right-arrow,
QScrollBar::up-arrow,
QScrollBar::down-arrow,
QScrollBar::sub-line,
QScrollBar::add-line,
QScrollBar::add-page,
QScrollBar::sub-page {
  background: #2e2e2e;
  height: 0;
  width: 0;
  border-radius: 0;
  border: 0;
}
 

/* --- MENUS --- */

QStatusBar QLabel {
    padding: 4px 8px;
    color: #b0b0b0;
}

QMenuBar {
    background-color: transparent;
    color: #ffffff;
    padding: 5px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 10px;
    margin-left: 4px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: rgba(255, 255, 255, 20);
}

QMenuBar::item:pressed {
    background-color: rgba(255, 255, 255, 13);
    color: #c8c8c8;
}

QMenu {
    background-color: #202020;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 1px;
    border: 1px solid rgba(255, 255, 255, 8);
    border-radius: 0px;
}

QMenu::indicator,
QMenu::icon {
    left: 4px; 
}

QMenu::separator {
    height: 0px;
    margin: 0px;
}

QMenu::item {
    background-color: transparent;
    padding: 5px 15px;
    border-radius: 5px;
    min-width: 60px;
    margin-top: 3px;
    margin-bottom: 3px;
}

QMenu::item:selected {
    background-color: rgba(255, 255, 255, 16);
}

QMenu::item:pressed {
    background-color: rgba(255, 255, 255, 10);
}

/* TODO impostare immagine svg appropriata */
QMenu::right-arrow {
    image: url(:/uitheme/controls/dark/TreeViewClose.svg);
    min-width: 40px;
    min-height: 18px;
}

QMenuBar:disabled {
    color: rgb(150, 150, 150);
}

QMenu::item:disabled {
    color: rgb(150, 150, 150);
    background-color: transparent;
}


/* --- SPLASH SCREEN CUSTOMIZATION --- */

QWidget#loadingPage,
QWidget#selectionPage,
QFrame#SplashContainer > * {
    background: none;
}

QLabel#logoLabel{
    background: none;
}

QLabel#appNameLbl{
    background: none;
    color: white; 
    font-size: 48px; 
    font-weight: bold; 
    font-family: "Inter", sans-serif;
}

QLabel#appVersionLbl{
    background: none;
    color: #717D96; 
    font-weight: light; 
    font-size: 12px; 
    font-family: "Inter", sans-serif;
}

QLabel#statusLbl{
    background: none;
    color: #CBD2E0; 
    font-size: 12px; 
    font-weight: semi-bold;
    font-family: "Inter", sans-serif;
}

QLabel#copyrightLbl{
    background: none;
    color: #717D96; 
    font-weight: light; 
    font-size: 11px; 
    line-height: 15px; 
    font-family: "Inter", sans-serif;
}

QFrame#SplashContainer {
    border-image: url(:/imgs/EMCR splash background.png) 0 0 0 0 stretch stretch;
    border-radius: 15px;       
}

QComboBox#deviceCombo {
    background-color: rgba(45, 55, 72, 0.5); 
    border: 1px solid #3f4e66;
    border-radius: 6px;
    padding: 10px 15px;
    color: #e2e8f0;
    font-size: 13px;
    font-style: italic; 
}


/* --- MULTIPLE CHANNEL CONTROLS --- */

/* Header di sezione (es. VISIBILITY & PLOTTING) */
QFrame#sectionHeaderContainer{
    background-color: #4A5468;
}

QLabel#sectionHeader {
    background-color: #4A5468;
    color: #A0ABC0;
    padding: 4px 8px;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 1px;
}

QComboBox#deviceCombo::drop-down {
    border: none;
    width: 30px;
    color: #FFFFFF;
}

/* Pulsante CONNECT */
QPushButton#connectBtn {
    background-color: #2d3748; 
    color: #cbd5e0;
    border: 1px solid #4a5568;
    border-radius: 6px;
    padding: 12px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QPushButton#connectBtn:hover {
    background-color: #4a5568;
    color: white;
}

/* 
--- Reference property mapping ---

{EXPAND, "Expand"},
{PLOT_DETAIL, "PlotDetail"},
{CH_INPUT, "ChInput"},
{STIMULUS, "Stimulus"} 
----------------------------------
*/


QLabel#propertyBadge {
    background-color: #0078d4;
    color: white;
    border-radius: 2px;
    font-weight: bold;
    font-size: 10px;
}
/* Badge per property EXPAND*/
QLabel#propertyBadge[propertyValue="E"] {
    background-color: rgba(74, 222, 128, 0.2);
    color: #4ade80;
}

/* Badge per property PLOT_DETAIL*/
QLabel#propertyBadge[propertyValue="P"] {
    background-color: rgba(241, 52, 247, 0.2);
    color: #F134F7;
}

/* Badge per property CH_INPUT*/
QLabel#propertyBadge[propertyValue="O"] {
    background-color: rgba(74, 84, 104, 0.2);
    color: #4A5468;
}

/* Badge per property STIMULUS*/
QLabel#propertyBadge[propertyValue="X"] {
    background-color: rgba(255, 82, 82, 0.2);
    color: #FF5252;
}

QLabel#propertyBadge[propertyValue="C"]{
    background-color: rgba(0, 120, 212, 0.2);
    color: white;
    border-radius: 2px;
    font-weight: bold;
    font-size: 10px;
}

QLabel#propertyBadge[propertyValue="J"]{
    background-color: rgba(0, 120, 212, 0.2);
    color: white;
    border-radius: 2px;
    font-weight: bold;
    font-size: 10px;
}

/* Stile per i Badges */
QLabel#badge {
    border-radius: 4px;
    font-size: 9px;
    font-weight: bold;
    padding: 2px 4px;
}

/* Colore Arancio per lo stato MIXED */
QLabel[status="mixed"] {
    background-color: rgba(226, 158, 46, 0.2); /* Arancio tenue */
    color: #E29E2E;
    border: 1px solid #E29E2E;
}

/* Colore Verde per lo stato ON */
QLabel[status="on"] {
    background-color: rgba(74, 222, 128, 0.2);
    color: #4ade80;
    border: 1px solid #2d5a27;
}

QLabel#activationSwitch {
    qproperty-alignment: 'AlignCenter';
}

/* Stato OFF */
QLabel#activationSwitch[checked="false"] {
    qproperty-pixmap: url(":/imgs/svg/toggle_off.svg");
}

/* Stato ON */
QLabel#activationSwitch[checked="true"] {
    qproperty-pixmap: url(":/imgs/svg/toggle_on.svg");
}

/* Label AUTO spenta (default) */
QLabel#autoLabel {
    color: #666666; 
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 0.5px;
}

/* Label AUTO accesa */
QLabel#autoLabel[active="true"] {
    color: #B0DCFF; /* Blu */
}

/* Contatore canali selezionati in alto */
/* Il contatore canali ora segue lo stesso stile senza stacchi */
QLabel#selectionCounter {
    background-color: #2D3648; 
    color: #B0DCFF;
    padding: 5px;
    font-size: 10px;
    font-weight: bold;
    border-bottom: 1px solid #2d323e;
    border-top: 1px solid #3d4655;
}

/* empty - quando nessun canale è selezionato */
QLabel#selectionCounter[empty="true"] {
    color: #666666; /* Grigio spento */
}

QFrame#propertyContainer {
    border: 1px solid #3d4655;
    border-right: none;
    border-left: none;
    margin: 4px;
    padding-right: 8px;
    padding-left: 8px;
}

QLabel#propertyName{
    color: #888888;
    text-transform: uppercase;
    font-size: 10px;
    font-weight: bold;
}

QWidget#customTitleBar {
    background-color: #CBD2E0;
}

QLabel#titleLabel {
    color: #CBD2E0;
    font-weight: bold;
    font-size: 11px;
    letter-spacing: 1px;
}

QWidget#multipleChannelControlsDw{
    border: 1px solid #343e4d;
    border-radius: 10px;
}


/* Rimuove il bordo nativo del DockWidget */
QDockWidget#MultipleChannelControlDockWidget {
    border: none;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

/* Wrapper per i contenuti */
QFrame#mainWrapper {
    background-color: #1e1e1e;
    border: 1px solid #3d4655; /* Bordo bluastro */
    border-top: none;        
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

QWidget#customTitleBar {
    background-color: #2D3648;
    border: 1px solid #3d4655;
    border-top-right-radius: 10px;
    border-top-left-radius: 10px;
}

/* Custom Window - Pulsanti Close (X) ed Espandi */
QPushButton#windowClose,
QPushButton#windowExpand {
    background: transparent;
    color: #a0aab4;
    border: none;
    width: 8px;
    padding: 2px;
    margin: 0px; 
}

QPushButton#windowExpand {
    image: url(:/imgs/svg/window-restore-regular.svg);
}

QPushButton#windowClose{
    image: url(:/imgs/svg/x-solid.svg);
}

QPushButton#windowClose:hover,
QPushButton#windowExpand:hover {
    background-color: #4a5568;
    color: white;
}


/* --- MULTIPLE CHANNEL CONTROLS / SUMMARY --- */

/* Contenitore generale con bordo superiore */
QWidget#summaryContainer {
    border-top: 1px solid #343e4d;
    background-color: #1e2430;
}

/* Cella singola del Summary*/

/* Celle custom per ogni Property (E, X, P, etc.) */
QWidget#summaryCell[value="P"]{
    border-top: 1px solid #343e4d;
    border-left: 1px solid #343e4d;
}

QWidget#summaryCell[value="X"]{
    border-top: 1px solid #343e4d;
    border-left: 1px solid #343e4d;
}

QWidget#summaryCell[value="E"]{
    border-top: 1px solid #343e4d;
}

QWidget#summaryCell[value="O"]{
    border-top: 1px solid #343e4d;
}

/* Label cella del Summary */
QLabel#summaryCellName {
    color: #888888;
    text-transform: uppercase;
    font-size: 9px;
    font-weight: bold;
}

/* Valore cella del Summary */
QLabel#summaryCellValue {
    font-size: 10px;
    font-weight: bold;
}

QLabel#summaryCellValue[status="on"] { color: #4ade80; }   /* Verde */
QLabel#summaryCellValue[status="auto"] { color: #B0DCFF; } /* Blu */

/* TODO capire se conviene usare solo # */

/* Pulsante di Toggle Modalità */
#modeToggleBtn {
    background: transparent;
    color: #A0ABC0;
    border: none;
    font-size: 10px;
    padding: 0px 5px;
}

#modeToggleBtn:hover {
    color: #B0DCFF;
}

/* Label delle righe Expert */
#offsetRowLabel {
    color: #D0D0D0;
    font-size: 10px;
    margin-left: 4px;
}

#modeContainer {
    background-color: transparent;
    border: none;
}

/* Pulsanti START/STOP nella modalità Basic */
#modeContainer QPushButton {
    background-color: #333333;
    border: 1px solid #454545;
    border-radius: 3px;
    color: #D0D0D0;
    font-weight: bold;
    font-size: 10px;
}

#modeContainer QPushButton:hover {
    background-color: #3D3D3D;
}

#modeContainer QPushButton:pressed {
    background-color: #1A1A1A;
    border-color: #B0DCFF;
}